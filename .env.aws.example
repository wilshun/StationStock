# Copy to .env.aws on the EC2 host. Never commit the real file.
ENVIRONMENT=production
DOMAIN=inventory.example.com
ACME_EMAIL=admin@example.com
POSTGRES_DB=stationstock
POSTGRES_USER=stationstock
POSTGRES_PASSWORD=replace-with-a-generated-long-random-password
AUTH_SECRET_KEY=replace-with-a-generated-value-of-at-least-32-random-characters
AUTH_COOKIE_NAME=stationstock_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALLOWED_FRONTEND_ORIGIN=https://inventory.example.com
API_DOCS_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=https://inventory.example.com/api/v1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_COOLDOWN_SECONDS=60
S3_BACKUP_BUCKET=replace-with-the-private-stationstock-backup-bucket-name
AWS_REGION=us-east-1
