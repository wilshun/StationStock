# Copy to .env.production on the production host. Never commit the real file.
ENVIRONMENT=production
POSTGRES_DB=stationstock
POSTGRES_USER=stationstock
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=stationstock_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALLOWED_FRONTEND_ORIGIN=https://inventory.example.com
API_DOCS_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=https://inventory-api.example.com/api/v1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_COOLDOWN_SECONDS=60
